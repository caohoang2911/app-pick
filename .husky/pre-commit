#!/usr/bin/env sh
echo "🔍 Running pre-commit checks..."

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No staged files to check"
  exit 0
fi

# Check 1: Run lint-staged (Prettier format check on staged files)
if command -v npx &> /dev/null; then
  echo "📦 Running lint-staged (format check)..."
  echo ""

  # Capture output để hiển thị chi tiết
  LINT_STAGED_OUTPUT=$(npx lint-staged 2>&1)
  LINT_STAGED_EXIT=$?

  # Hiển thị output
  echo "$LINT_STAGED_OUTPUT"
  echo ""

  if [ $LINT_STAGED_EXIT -ne 0 ]; then
    echo "❌ Format check failed!"
    echo ""
    echo "💡 To fix format issues, run:"
    echo "   yarn prettier --write .lintstagedrc.js *.md"
    echo "   or"
    echo "   npm run lint:fix"
    echo ""
    exit 1
  fi
else
  echo "⚠️  npx not found, skipping lint-staged"
fi

# Check 2: TypeScript type checking (check all files, not just staged)
echo "📘 Running TypeScript type check..."
if command -v npx &> /dev/null; then
  npx tsc --noEmit --pretty false > /dev/null 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ TypeScript errors found!"
    npx tsc --noEmit
    exit 1
  fi
  echo "✅ TypeScript check passed"
else
  echo "⚠️  npx not found, skipping type check"
fi

# Check 3: Run additional checks script
if [ -f "scripts/pre-commit-checks.sh" ]; then
  echo "🔍 Running additional checks..."
  bash scripts/pre-commit-checks.sh

  if [ $? -ne 0 ]; then
    echo "❌ Additional checks failed"
    exit 1
  fi
fi

echo "✅ All pre-commit checks passed!"
