   @ThreadConfined(UI)
   public void onHostPause(@Nullable Activity activity) {
+    // Guard against activity lifecycle desync (e.g. an Activity launched in the
+    // background for an incoming call is paused before onHostResume set the
+    // current activity). Skipping the assertion avoids a fatal "Unable to pause
+    // activity" AssertionError; the no-arg onHostPause() still runs the cleanup.
+    if (mCurrentActivity == null) {
+      FLog.w(
+          ReactConstants.TAG,
+          "onHostPause called with null current activity, skipping activity assertions.");
+      onHostPause();
+      return;
+    }
     if (mRequireActivity) {
       Assertions.assertCondition(mCurrentActivity != null);
     }
