{
  "build": {
    "dev": {
      "node": "22.9.0",
      "autoIncrement": true,
      "developmentClient": false,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "prebuildCommand": "./commands/prebuild.sh"
      },
      "ios": {
        "distribution": "store",
        "image": "macos-sequoia-15.6-xcode-26.2",
        "resourceClass": "m-medium",
        "prebuildCommand": "./commands/prebuild.sh",
        "simulator": false,
        "env": {
          "COCOAPODS_VERSION": "1.16.2"
        }
      },
      "channel": "development",
      "env": {
        "EAS_BUILD_PROFILE": "dev"
      }
    },
    "dev-device": {
      "extends": "dev",
      "ios": {
        "distribution": "internal"
      }
    },
    "prod": {
      "node": "22.9.0",
      "autoIncrement": true,
      "developmentClient": false,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "prebuildCommand": "./commands/prebuild.sh"
      },
      "ios": {
        "distribution": "store",
        "image": "macos-sequoia-15.6-xcode-26.2",
        "resourceClass": "m-medium",
        "prebuildCommand": "./commands/prebuild.sh",
        "env": {
          "COCOAPODS_VERSION": "1.16.2"
        }
      },
      "channel": "production",
      "env": {
        "EAS_BUILD_PROFILE": "prod"
      }
    }
  },
  "submit": {
    "dev": {},
    "prod": {}
  },
  "cli": {
    "version": ">= 7.3.0",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  }
}
